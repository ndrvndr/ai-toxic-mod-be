{
  "name": "ai-toxic-mod-be",
  "private": true,
  "packageManager": "bun@1.3.9",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "tsdown",
    "composer:deploy": "prisma deploy module.ts",
    "composer:dev": "prisma dev module.ts",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "deploy": "bun run build && bun run composer:deploy",
    "dev": "bun --watch src/main.ts",
    "dev:composer": "bun run build && bun run composer:dev",
    "migrate": "prisma db migrate",
    "migration:plan": "prisma migration plan",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "skills:sync": "prisma skills sync || exit 0",
    "start": "node dist/server.mjs",
    "postinstall": "prisma skills sync || exit 0",
    "test": "bun test --timeout 60000",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.1.17",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/platform-socket.io": "11.1.6",
    "@nestjs/swagger": "8.1.1",
    "@nestjs/websockets": "11.1.6",
    "@prisma/composer": "0.17.0",
    "@prisma/composer-prisma-cloud": "0.17.0",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "alchemy": "2.0.0-beta.74",
    "bullmq": "^6.3.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "googleapis": "^178.0.0",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "temporal-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.3",
    "@types/bun": "^1.4.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "prisma": "latest",
    "socket.io-client": "^4.8.3",
    "tsdown": "^0.22.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
